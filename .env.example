# Plantilla de credenciales. Copiar a `.env` y rellenar con los valores reales.
# `.env` está en .gitignore: NUNCA se versiona.
#
# Los valores están en Supabase → Project Settings → API.

# ── Frontend ────────────────────────────────────────────────────────────────
# Vite expone al navegador todo lo que empiece por VITE_, así que aquí solo va
# lo que puede ser público. La anon key lo es por diseño: viaja en el bundle.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=pega-aqui-la-anon-key

# ── Scripts ETL ─────────────────────────────────────────────────────────────
# La service_role SALTA TODA LA RLS: puede leer y borrar cualquier tabla de la
# base, que es compartida con otros módulos. No lleva prefijo VITE_ justamente
# para que Vite no la meta en el bundle. No pegarla en Vercel ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key
